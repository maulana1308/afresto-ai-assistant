# Salin file ini menjadi .env di folder deploy/vps-converter/ lalu isi nilainya
# Gunakan port lokal terpisah agar tidak bentrok dengan Bot WA / Discord Anda
HOST=127.0.0.1
PORT=3845

# OPSI PRAKTIS: Jika API Key Gemini sudah ada di .env proyek Bot WA / Discord Anda di VPS,
# cukup arahkan ke file .env tersebut (server otomatis membaca GEMINI_API_KEY, GEMINI_API_KEYS,
# maupun GEMINI_API_KEY_1..6 / GEMINI_KEY_1..6 tanpa perlu salin ulang):
# EXTRA_ENV_FILES=/root/bot-wa/.env,/root/bot-discord/.env
EXTRA_ENV_FILES=

# Pool Multi-Key Gemini (pisah koma) — rotasi round-robin & failover otomatis jika salah satu limit 429!
# Contoh 6 key dari 6 akun berbeda:
GEMINI_API_KEYS=

# Atau pakai 1 key saja (boleh dikosongkan jika sudah mengisi GEMINI_API_KEYS di atas):
GEMINI_API_KEY=

# Model Gemini Vision untuk membaca gambar pernyataan Benar/Salah
GEMINI_MODEL=gemini-2.5-flash

# Kosongkan jika dibuka umum ("terima jadi"); isi jika ingin wajib PIN khusus OCR
CONVERTER_ACCESS_PIN=

# Pagar anti-banjir & penjaga kuota API publik:
# 1. Maksimal request OCR per IP dalam 15 menit (default 15, cukup ~3 paket naskah per guru)
OCR_RATE_LIMIT_MAX=15
OCR_RATE_LIMIT_WINDOW_MS=900000

# 2. Circuit breaker kuota total server per hari (0 = tanpa batas harian)
OCR_DAILY_GLOBAL_MAX=300

# 3. Domain resmi yang diizinkan memanggil /api/ocr-bs (kosongkan agar otomatis cocok dengan Host Nginx)
ALLOWED_ORIGIN=
