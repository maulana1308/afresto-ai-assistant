<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="51553A56" w14:textId="0D8610FB" w:rsidR="00882835" w:rsidRDefault="00882835"/><w:p w14:paraId="4DABC39E" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5"><w:pPr><w:spacing w:before="160" w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="1F4E79"/><w:sz w:val="24"/></w:rPr><w:t>TEXT 1 – HOW TO MAKE A VEGETABLE OMELET</w:t></w:r></w:p><w:p w14:paraId="517C5E16" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="11"/></w:numPr><w:spacing w:after="80" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>Ingredients:</w:t></w:r><w:r><w:br/><w:t>- 2 eggs</w:t></w:r><w:r><w:br/><w:t>- 2 tablespoons of chopped carrots</w:t></w:r><w:r><w:br/><w:t>- 2 tablespoons of chopped spring onions</w:t></w:r><w:r><w:br/><w:t>- A pinch of salt and pepper</w:t></w:r><w:r><w:br/><w:t>- 1 tablespoon of cooking oil</w:t></w:r></w:p><w:p w14:paraId="2B325C18" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="11"/></w:numPr><w:spacing w:after="80" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>Steps:</w:t></w:r><w:r><w:br/><w:t>1. First, crack the eggs into a bowl.</w:t></w:r><w:r><w:br/><w:t>2. Add the chopped carrots, spring onions, salt, and pepper.</w:t></w:r><w:r><w:br/><w:t>3. Beat the mixture with a fork until everything is combined.</w:t></w:r><w:r><w:br/><w:t>4. Heat the cooking oil in a frying pan over medium heat.</w:t></w:r><w:r><w:br/><w:t>5. Pour the egg mixture into the pan.</w:t></w:r><w:r><w:br/><w:t>6. Cook for about two minutes until the bottom is firm.</w:t></w:r><w:r><w:br/><w:t>7. Carefully fold the omelet in half and cook for another minute.</w:t></w:r><w:r><w:br/><w:t>8. Finally, transfer it to a plate and serve while warm.</w:t></w:r></w:p><w:p w14:paraId="4603BFFD" w14:textId="71EC53F3" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>What is the purpose of the text?</w:t></w:r></w:p><w:p w14:paraId="18E91A64" w14:textId="1B175C25" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To explain how to make a vegetable omelet.</w:t></w:r></w:p><w:p w14:paraId="41A61AC3" w14:textId="2E974A68" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To describe different kinds of vegetables.</w:t></w:r></w:p><w:p w14:paraId="1C5D79AB" w14:textId="4CE8A475" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To tell the history of omelets.</w:t></w:r></w:p><w:p w14:paraId="49114BE5" w14:textId="1105F3F2" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To explain how to clean a frying pan.</w:t></w:r></w:p><w:p w14:paraId="37996190" w14:textId="0150BBC1" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To compare eggs and vegetables.</w:t></w:r></w:p><w:p w14:paraId="1240B532" w14:textId="26D2EAC5" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>What should we do after adding the vegetables and seasonings?</w:t></w:r></w:p><w:p w14:paraId="5773F782" w14:textId="7D54985C" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Heat the cooking oil.</w:t></w:r></w:p><w:p w14:paraId="16EB26D9" w14:textId="3257E4AA" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Beat the mixture with a fork.</w:t></w:r></w:p><w:p w14:paraId="563E0688" w14:textId="3B19A5BB" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Fold the omelet in half.</w:t></w:r></w:p><w:p w14:paraId="248D75FC" w14:textId="7D3B1C4B" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Transfer the omelet to a plate.</w:t></w:r></w:p><w:p w14:paraId="61F41192" w14:textId="0B96CF80" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Serve the omelet immediately.</w:t></w:r></w:p><w:p w14:paraId="6B5303C0" w14:textId="4E5E20E1" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>How much cooking oil is needed?</w:t></w:r></w:p><w:p w14:paraId="6AC3C44C" w14:textId="52446A9F" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>One teaspoon.</w:t></w:r></w:p><w:p w14:paraId="734E9902" w14:textId="65905E6A" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Two teaspoons.</w:t></w:r></w:p><w:p w14:paraId="2950D62B" w14:textId="0CF2CA22" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>One tablespoon.</w:t></w:r></w:p><w:p w14:paraId="1D34ED97" w14:textId="51B78699" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Two tablespoons.</w:t></w:r></w:p><w:p w14:paraId="128B75A7" w14:textId="33FD7E27" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Three tablespoons.</w:t></w:r></w:p><w:p w14:paraId="0B2D3933" w14:textId="1065EBB4" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>Why should the pan be heated over medium heat?</w:t></w:r></w:p><w:p w14:paraId="60F80F79" w14:textId="2E6CFF7B" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To make the eggs freeze.</w:t></w:r></w:p><w:p w14:paraId="27768CC5" w14:textId="2379F748" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To prevent the omelet from cooking.</w:t></w:r></w:p><w:p w14:paraId="0A03260E" w14:textId="3FC06B27" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To help cook the egg mixture properly.</w:t></w:r></w:p><w:p w14:paraId="35D79B50" w14:textId="358750CF" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To make the vegetables disappear.</w:t></w:r></w:p><w:p w14:paraId="2B6E16B1" w14:textId="082797CC" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To cool the cooking oil.</w:t></w:r></w:p><w:p w14:paraId="39695AD8" w14:textId="7351994B" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>When should the omelet be folded?</w:t></w:r></w:p><w:p w14:paraId="19CEE271" w14:textId="0D712B7C" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Before cracking the eggs.</w:t></w:r></w:p><w:p w14:paraId="30D1D7F4" w14:textId="22D60E62" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>After beating the mixture.</w:t></w:r></w:p><w:p w14:paraId="7D566961" w14:textId="7C0ADF84" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>When the bottom is firm.</w:t></w:r></w:p><w:p w14:paraId="7715A1D9" w14:textId="4A6DB58D" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Before heating the pan.</w:t></w:r></w:p><w:p w14:paraId="13EF0C87" w14:textId="384C3890" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>After transferring it to a plate.</w:t></w:r></w:p><w:p w14:paraId="54C052E9" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="71399380" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="160" w:after="80"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/><w:color w:val="1F4E79"/><w:sz w:val="24"/></w:rPr><w:lastRenderedPageBreak/><w:t>TEXT 2 – HOW TO MAKE A FRESH FRUIT SALAD</w:t></w:r></w:p><w:p w14:paraId="48DC940E" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="14"/></w:numPr><w:spacing w:after="80" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>Ingredients:</w:t></w:r><w:r><w:br/><w:t>- 1 apple</w:t></w:r><w:r><w:br/><w:t>- 1 banana</w:t></w:r><w:r><w:br/><w:t>- 100 grams of papaya</w:t></w:r><w:r><w:br/><w:t>- 100 grams of watermelon</w:t></w:r><w:r><w:br/><w:t>- 3 tablespoons of plain yogurt</w:t></w:r><w:r><w:br/><w:t>- 1 tablespoon of honey</w:t></w:r></w:p><w:p w14:paraId="5128AEFB" w14:textId="77777777" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="14"/></w:numPr><w:spacing w:after="80" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>Steps:</w:t></w:r><w:r><w:br/><w:t>1. First, wash the apple, papaya, and watermelon under running water.</w:t></w:r><w:r><w:br/><w:t>2. Peel the banana and remove the apple core.</w:t></w:r><w:r><w:br/><w:t>3. Cut all the fruits into small, bite-sized pieces.</w:t></w:r><w:r><w:br/><w:t>4. Put the fruit pieces into a large clean bowl.</w:t></w:r><w:r><w:br/><w:t>5. In a small bowl, mix the yogurt and honey until smooth.</w:t></w:r><w:r><w:br/><w:t>6. Pour the yogurt dressing over the fruit.</w:t></w:r><w:r><w:br/><w:t>7. Gently toss the fruit so that the dressing covers the pieces.</w:t></w:r><w:r><w:br/><w:t>8. Chill the salad in the refrigerator for about 15 minutes.</w:t></w:r><w:r><w:br/><w:t>9. Serve the fruit salad in small serving bowls.</w:t></w:r></w:p><w:p w14:paraId="20CDC17B" w14:textId="3CC19F02" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>What is the main purpose of the procedure?</w:t></w:r></w:p><w:p w14:paraId="10844D8C" w14:textId="3B4B96F1" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To explain how to make fresh fruit salad.</w:t></w:r></w:p><w:p w14:paraId="3E9FC0BC" w14:textId="674129D2" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To describe the taste of yogurt.</w:t></w:r></w:p><w:p w14:paraId="11B1D413" w14:textId="3DB0421F" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To explain how to grow fruit trees.</w:t></w:r></w:p><w:p w14:paraId="6E21A654" w14:textId="7DA4F4E7" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To show how to make fruit juice.</w:t></w:r></w:p><w:p w14:paraId="1BF6E505" w14:textId="5A398B9E" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To describe a refrigerator.</w:t></w:r></w:p><w:p w14:paraId="69BCB812" w14:textId="4813FED8" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>Which fruit needs to be peeled?</w:t></w:r></w:p><w:p w14:paraId="07EE80C8" w14:textId="7E0D0B65" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Apple.</w:t></w:r></w:p><w:p w14:paraId="63CF1DE5" w14:textId="2709D7B9" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Watermelon.</w:t></w:r></w:p><w:p w14:paraId="1BBABE99" w14:textId="6D778188" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Papaya.</w:t></w:r></w:p><w:p w14:paraId="662EB657" w14:textId="3C865404" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Banana.</w:t></w:r></w:p><w:p w14:paraId="291621BE" w14:textId="00A2031F" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>All of the fruits.</w:t></w:r></w:p><w:p w14:paraId="51192C59" w14:textId="5091846A" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>What should be mixed in a small bowl?</w:t></w:r></w:p><w:p w14:paraId="4DC72042" w14:textId="421FABB1" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Apple and banana.</w:t></w:r></w:p><w:p w14:paraId="6B2D5A37" w14:textId="7D2C2671" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Papaya and watermelon.</w:t></w:r></w:p><w:p w14:paraId="45EAF2CE" w14:textId="576DB8FC" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Yogurt and honey.</w:t></w:r></w:p><w:p w14:paraId="6171A85E" w14:textId="733ECC47" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Water and sugar.</w:t></w:r></w:p><w:p w14:paraId="60550EB0" w14:textId="1F67C622" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="13"/></w:numPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Salt and pepper.</w:t></w:r></w:p><w:p w14:paraId="3A216F66" w14:textId="67A63E23" w:rsidR="00882835" w:rsidRDefault="00996CA5" w:rsidP="007D62EF"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="13"/></w:numPr><w:spacing w:before="80" w:after="20"/></w:pPr><w:r w:rsidRPr="007D62EF"><w:rPr><w:b/></w:rPr><w:t>How long should the fruit salad be chilled?</w:t></w:r></w:p><w:p w14:paraId="2FBB6064" w14:textId="68AEA4E6" w:rsidR="0088283