{
  "manifest_version": 3,
  "name": "Afresto AI Assistant",
  "version": "3.0.0",
  "description": "Asisten AI Cerdas Pembuat Soal Asesmen dan Materi Pembelajaran Berstandar BSKAP untuk Portal Afresto",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka Asisten Soal Afresto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.afresto.id/*",
    "https://generativelanguage.googleapis.com/*",
    "https://image.pollinations.ai/*",
    "https://pollinations.ai/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.afresto.id/*"
      ],
      "js": [
        "scripts/injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "preview/preview.html",
        "preview/preview.css",
        "preview/preview.js",
        "scripts/*",
        "icons/*",
        "TEMPLATE_SOAL_AFRESTO.docx",
        "PANDUAN_TUTORIAL_AFRESTO_AI.pdf"
      ],
      "matches": [
        "*://*.afresto.id/*"
      ]
    }
  ]
}
